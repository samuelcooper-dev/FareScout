# Amadeus API (test sandbox)
AMADEUS_CLIENT_ID=your_client_id_here
AMADEUS_CLIENT_SECRET=your_client_secret_here
AMADEUS_HOSTNAME=test  # or "production"

# BigQuery
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GCP_PROJECT_ID=your_gcp_project_id
BQ_DATASET_RAW=raw
BQ_DATASET_ANALYTICS=analytics

# Redpanda
REDPANDA_BROKERS=localhost:9092
REDPANDA_TOPIC_PRICE_DROP=price_drop_events

# Alert thresholds
PRICE_DROP_THRESHOLD=0.15  # 15% below trailing baseline

# Airflow (if running locally)
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__CORE__EXECUTOR=LocalExecutor
